[Unit]
Description=QEMU Emulator Manager
After=network.target

[Service]
Type=simple
User=emulator
Group=emulator
EnvironmentFile=/etc/qemu-ios-emulator/manager.env
WorkingDirectory=/var/lib/qemu-ios-emulator
ExecStart=/opt/qemu-ios-emulator/manager
Restart=on-failure
RestartSec=5

# Hardening. The manager starts QEMU as child processes; stopping the unit
# stops every VM it launched (KillMode=control-group is the default).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qemu-ios-emulator /var/log/qemu-ios-emulator

[Install]
WantedBy=multi-user.target
